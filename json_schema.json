{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcgamearchive.org/schemas/juego.schema.json",
  "title": "Ficha de juego",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "num",
    "ig",
    "titulo",
    "url",
    "plataforma",
    "formato",
    "genero",
    "desarrollador",
    "distribuidor",
    "ean",
    "descripcion",
    "incluye",
    "serie",
    "tags",
    "proteccion",
    "anio",
    "mercado",
    "idioma",
    "soporte",
    "tipo_edicion"
  ],
  "properties": {
    "num": {
      "type": "string",
      "pattern": "^\\d{6}$"
    },
    "ig": {
      "type": "string",
      "anyOf": [
        {
          "format": "uri",
          "pattern": "^https://"
        },
        {
          "const": ""
        }
      ]
    },
    "titulo": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "pattern": "^juegos\\/[a-z0-9\\-]+\\/$"
    },
    "plataforma": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "MacOs",
          "MsDos",
          "Win10",
          "Win11",
          "Win2000",
          "Win3.x",
          "Win7",
          "Win8",
          "Win95",
          "Win98",
          "Windows Vista",
          "WinMe",
          "WinNT",
          "WinXP"
        ]
      }
    },
    "formato": {
      "type": "string",
      "enum": [
        "Big Box",
        "DVD Case",
        "Jewel Case"
      ]
    },
    "genero": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "desarrollador": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "distribuidor": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ean": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(\\d{8}|\\d{13})$"
      }
    },
    "descripcion": {
      "type": "string",
      "minLength": 1
    },
    "incluye": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "serie": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "Age of Empires",
          "Best of Atari",
          "BestSeller Series",
          "Big Box",
          "DVD Case",
          "Jewel Case",
          "Codegame",
          "Computer hoy juegos",
          "Dinamic multimedia",
          "EA Games Classics",
          "EA Sports",
          "EA Value Games",
          "FX Interactive",
          "Games for windows",
          "Heroes of Might and Magic",
          "Juegos del verano",
          "Limited Run",
          "Los Sims",
          "LucasArts Legends",
          "Market way",
          "Mk Interactive",
          "RED Collection",
          "World of Warcraft",
          "Xtreme Collection",
          "Zeta Games",
          "Zipi y Zape",
          "Todos"
        ]
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proteccion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "version",
        "preservacion",
        "formato",
        "jugable_virtual"
      ],
      "properties": {
        "tipo": {
          "type": "string",
          "enum": [
            "Sin protección",
            "Verificación de CD",
            "Código o clave",
            "Manual lookup",
            "Key disk",
            "Rol de claves",
            "SafeDisc",
            "SecuROM",
            "LaserLock",
            "DiscGuard",
            "CD-Cops",
            "StarForce",
            "TAGES",
            "ProtectDISC",
            "No determinado",
            "Uplay/activación online",
            "DRM online de Ubisoft",
            "Otro"
          ]
        },
        "version": {
          "type": "string"
        },
        "preservacion": {
          "type": "string",
          "minLength": 1
        },
        "formato": {
          "type": "string",
          "enum": [
            "ISO",
            "BIN/CUE",
            "MDF/MDS",
            "NRG",
            "CCD/IMG/SUB",
            "WAV/CUE",
            "No aplica",
            "Otro"
          ]
        },
        "jugable_virtual": {
          "type": "boolean"
        }
      }
    },
    "anio": {
      "type": "string",
      "pattern": "^$|^\\d{4}$",
      "description": "Año de publicación de la edición física catalogada. Usa cuatro dígitos; vacío si todavía no está documentado."
    },
    "mercado": {
      "type": "array",
      "uniqueItems": true,
      "description": "Mercado o territorio comercial al que estaba destinada la edición física. Array vacío si todavía no está documentado.",
      "items": {
        "type": "string",
        "enum": [
          "España",
          "Portugal",
          "Francia",
          "Alemania",
          "Italia",
          "Reino Unido",
          "Irlanda",
          "Países Bajos",
          "Bélgica",
          "Luxemburgo",
          "Austria",
          "Suiza",
          "Dinamarca",
          "Suecia",
          "Noruega",
          "Finlandia",
          "Islandia",
          "Polonia",
          "República Checa",
          "Eslovaquia",
          "Hungría",
          "Rumanía",
          "Bulgaria",
          "Grecia",
          "Croacia",
          "Eslovenia",
          "Estonia",
          "Letonia",
          "Lituania",
          "Europa",
          "Estados Unidos",
          "Canadá",
          "México",
          "Norteamérica",
          "Brasil",
          "Argentina",
          "Latinoamérica",
          "Australia",
          "Nueva Zelanda",
          "Japón",
          "Corea del Sur",
          "China",
          "Asia",
          "Internacional",
          "Otro",
          "No determinado"
        ]
      }
    },
    "idioma": {
      "type": "array",
      "uniqueItems": true,
      "description": "Idiomas presentes en la edición física catalogada (caja, documentación y/o software según lo documentado). Array vacío si todavía no está documentado.",
      "items": {
        "type": "string",
        "enum": [
          "Español",
          "Catalán",
          "Gallego",
          "Euskera",
          "Portugués",
          "Inglés",
          "Francés",
          "Alemán",
          "Italiano",
          "Neerlandés",
          "Danés",
          "Sueco",
          "Noruego",
          "Finés",
          "Islandés",
          "Polaco",
          "Checo",
          "Eslovaco",
          "Húngaro",
          "Rumano",
          "Búlgaro",
          "Griego",
          "Croata",
          "Esloveno",
          "Estonio",
          "Letón",
          "Lituano",
          "Ruso",
          "Ucraniano",
          "Turco",
          "Árabe",
          "Hebreo",
          "Japonés",
          "Coreano",
          "Chino simplificado",
          "Chino tradicional",
          "Multilingüe",
          "Sin contenido lingüístico",
          "Otro",
          "No determinado"
        ]
      }
    },
    "soporte": {
      "type": "array",
      "uniqueItems": true,
      "description": "Soporte o soportes de distribución incluidos en la edición. Array vacío si todavía no está documentado.",
      "items": {
        "type": "string",
        "enum": [
          "Disquete 3,5\"",
          "Disquete 5,25\"",
          "CD-ROM",
          "DVD-ROM",
          "Blu-ray Disc",
          "CD de audio",
          "DVD de vídeo",
          "USB",
          "Tarjeta de memoria",
          "Código de descarga",
          "Sin soporte físico",
          "Otro",
          "No determinado"
        ]
      }
    },
    "tipo_edicion": {
      "type": "array",
      "uniqueItems": true,
      "description": "Clasificación de la edición física. Puede contener varios valores compatibles; array vacío si todavía no está documentado.",
      "items": {
        "type": "string",
        "enum": [
          "Lanzamiento original",
          "Reedición",
          "Budget",
          "Colección",
          "Compilación",
          "Bundle/Pack",
          "Edición especial",
          "Edición limitada",
          "Edición coleccionista",
          "OEM",
          "Promocional",
          "Prensa",
          "Demo",
          "Shareware",
          "Otro",
          "No determinado"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "formato": {
            "const": "Big Box"
          }
        }
      },
      "then": {
        "properties": {
          "serie": {
            "contains": {
              "const": "Big Box"
            }
          },
          "url": {
            "pattern": "-bigbox\\/$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "formato": {
            "const": "DVD Case"
          }
        }
      },
      "then": {
        "properties": {
          "serie": {
            "contains": {
              "const": "DVD Case"
            }
          },
          "url": {
            "pattern": "-cddvd\\/$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "formato": {
            "const": "Jewel Case"
          }
        }
      },
      "then": {
        "properties": {
          "serie": {
            "contains": {
              "const": "Jewel Case"
            }
          },
          "url": {
            "pattern": "-jewelcase\\/$"
          }
        }
      }
    }
  ]
}
